# Copy to `.env` and adjust. Values fall back to defaults in config.py.

# Minix loads this module automatically after `minix init`.
MINIX_SETTINGS_MODULE=config

# Application
DEBUG=false
APP_NAME=my_project
APP_HOST=0.0.0.0
APP_PORT=__APP_PORT__
# SECRET_KEY=

# SQL — primary connection (settings.DATABASES["default"])
DB_USER=__DB_USER__
DB_PASS=minix
DB_HOST=localhost
DB_PORT=__DB_PORT__
DB_DATABASE=minix
DB_DRIVER=__DB_DRIVER__

# __BEGIN_POSTGRESQL__
# PostgreSQL compose service
POSTGRES_PORT=__POSTGRES_PORT__
POSTGRES_USER=__POSTGRES_USER__
POSTGRES_PASSWORD=minix
POSTGRES_DB=minix
# __END_POSTGRESQL__
# __BEGIN_MYSQL__
# MySQL compose service
MYSQL_PORT=__MYSQL_PORT__
MYSQL_USER=__MYSQL_USER__
MYSQL_PASSWORD=minix
MYSQL_DATABASE=minix
MYSQL_ROOT_PASSWORD=rootpass
# __END_MYSQL__
# __BEGIN_MYSQL_SECONDARY__
# Secondary app connection settings.DATABASES["mysql"]
MYSQL_DB_USER=minix
MYSQL_DB_PASS=minix
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_DATABASE=minix
# __END_MYSQL_SECONDARY__
# __BEGIN_POSTGRESQL_SECONDARY__
# Secondary app connection settings.DATABASES["postgresql"]
POSTGRES_DB_USER=minix
POSTGRES_DB_PASS=minix
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_DATABASE=minix
# __END_POSTGRESQL_SECONDARY__

# Celery / Redis
REDIS_PORT=__REDIS_PORT__
CELERY_BROKER_URL=redis://localhost:__REDIS_PORT__/0
CELERY_RESULT_BACKEND=redis://localhost:__REDIS_PORT__/1
CELERY_TIMEZONE=GMT
# REDIS_URL=redis://localhost:__REDIS_PORT__/0

# Kafka / object storage
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OBJECT_STORAGE_PORT=__OBJECT_STORAGE_PORT__
OBJECT_STORAGE_CONSOLE_PORT=__OBJECT_STORAGE_CONSOLE_PORT__
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:__OBJECT_STORAGE_PORT__
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET_NAME=minix
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_VERIFY_SSL=false

# __BEGIN_VDB__
# Qdrant (minix[vdb])
QDRANT_PORT=__QDRANT_PORT__
QDRANT_GRPC_PORT=__QDRANT_GRPC_PORT__
QDRANT_URL=http://localhost:__QDRANT_PORT__
# QDRANT_API_KEY=

# __END_VDB__
# __BEGIN_CLICKHOUSE__
# ClickHouse (minix[clickhouse])
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=default
CLICKHOUSE_PASS=
CLICKHOUSE_DATABASE=default

# __END_CLICKHOUSE__
# __BEGIN_AI__
# MLflow (minix[ai])
MLFLOW_PORT=__MLFLOW_PORT__
MLFLOW_TRACKING_URL=http://localhost:__MLFLOW_PORT__

# __END_AI__
# __BEGIN_NO_AI__
MLFLOW_TRACKING_URL=http://localhost:5000

# __END_NO_AI__
PYTHON_VERSION=3.11
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SESSION_SECRET=
