# Copy to `.env` and adjust. Every key has a fallback in settings.py —
# you only need to set the ones you want to override.

# Minix loads this settings module automatically (default after `minix init`).
MINIX_SETTINGS_MODULE=settings

# Application
DEBUG=false
APP_NAME=my_project
APP_HOST=0.0.0.0
APP_PORT=8000
# SECRET_KEY=

# SQL
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=minix
DB_DRIVER=mysql

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=GMT
# REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Object storage (S3 / MinIO)
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET_NAME=minix
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_VERIFY_SSL=false

# MLflow (optional)
MLFLOW_TRACKING_URL=http://localhost:5000
PYTHON_VERSION=3.11

# OIDC (optional)
# OIDC_ISSUER=https://keycloak.example/realms/myrealm
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SESSION_SECRET=
